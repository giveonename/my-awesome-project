# ============================================================
# Wardrowbe（魔搭幻穿）环境变量模板
# 复制为 .env 并按需填写；后端读取 backend/app/config.py 中定义的字段
# ============================================================

# ---------- 基础 ----------
DEBUG=true
# 生产环境必须替换为随机值（如 openssl rand -hex 32）
SECRET_KEY=change-me-in-production
# JSON 数组格式
CORS_ORIGINS=["http://localhost:3000"]
STORAGE_PATH=/data/wardrobe
MAX_UPLOAD_SIZE_MB=10

# ---------- 数据库 / Redis（Docker 内使用容器名，本地开发用 localhost）----------
DATABASE_URL=postgresql+asyncpg://wardrobe:wardrobe@postgres:5432/wardrobe
REDIS_URL=redis://redis:6379/0

# ---------- 微信小程序 ----------
WECHAT_APPID=
WECHAT_SECRET=

# ---------- AI 文本/视觉理解（OpenAI 兼容 API，本项目使用 DeepSeek）----------
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
# 官方模型 ID（区分大小写；控制台公告的产品名不能直接填）
AI_VISION_MODEL=deepseek-flash
AI_TEXT_MODEL=deepseek-flash
AI_TIMEOUT=180
AI_MAX_RETRIES=3
AI_MAX_TOKENS=8000

# ---------- 阿里云 DashScope 虚拟试衣（qwen-image-3.0；原 OutfitAnyone/aitryon 已于 2026-10 下线）----------
DASHSCOPE_API_KEY=
DASHSCOPE_TRYON_MODEL=qwen-image-3.0
VIRTUAL_TRYON_TIMEOUT=300
# 以下两项为 aitryon 时代的历史配置，保留仅为兼容，不再使用
DASHSCOPE_REFINE_MODEL=aitryon-refiner
DASHSCOPE_PARSE_MODEL=aitryon-parsing-v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIRTUAL_TRYON_TIMEOUT=120

# ---------- 阿里云视觉智能（衣物分割/人像抠图）----------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_VISION_ENDPOINT=imageseg.cn-shanghai.aliyuncs.com

# ---------- 阿里云 OSS（可选：仅历史数据 public_url / 公网部署需要；浏览、试衣、天气背景均已本地化）----------
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION=
ALIYUN_OSS_PUBLIC_URL=

# ---------- 天气：和风天气 v7（国内优先）----------
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 天气：Open-Meteo（海外 fallback）
OPENMETEO_FALLBACK_URL=

# ---------- 淘宝联盟（不配置 APP_KEY 时自动使用 Mock 数据）----------
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
TAOBAO_MATERIAL_ID=17004

# ---------- 通知（ntfy 为默认通道，SMTP/Mattermost 为兼容保留）----------
NTFY_SERVER=
NTFY_TOPIC=
NTFY_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MATTERMOST_WEBHOOK_URL=

# ---------- OIDC 登录（可选，Web 端开发模式用）----------
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_MOBILE_CLIENT_ID=

# ---------- 背景移除（rembg 已退役；aliyun=阿里云分割（推荐），http=自建服务）----------
BG_REMOVAL_PROVIDER=aliyun
BG_REMOVAL_URL=
BG_REMOVAL_API_KEY=

# ---------- 图片处理 ----------
THUMBNAIL_SIZE=400
MEDIUM_SIZE=800
ORIGINAL_MAX_SIZE=2400
IMAGE_QUALITY=90
