# ============================================================
# Wardrowbe（魔搭幻穿）环境变量模板
# 复制为 .env 并按需填写；后端读取 backend/app/config.py 中定义的字段
# ============================================================

# ---------- 基础 ----------
DEBUG=true
# 生产环境必须替换为随机值（如 openssl rand -hex 32）
SECRET_KEY=change-me-in-production
# JSON 数组格式
CORS_ORIGINS=["http://localhost:3000"]
STORAGE_PATH=/data/wardrobe
MAX_UPLOAD_SIZE_MB=10

# ---------- 数据库 / Redis（Docker 内使用容器名，本地开发用 localhost）----------
DATABASE_URL=postgresql+asyncpg://wardrobe:wardrobe@postgres:5432/wardrobe
REDIS_URL=redis://redis:6379/0

# ---------- 微信小程序 ----------
WECHAT_APPID=
WECHAT_SECRET=

# ---------- AI 文本/视觉（OpenAI 兼容 API，本项目使用小米 MiMo）----------
AI_BASE_URL=
AI_API_KEY=
AI_VISION_MODEL=mimo-v2.5
AI_TEXT_MODEL=mimo-v2.5
AI_TIMEOUT=180
AI_MAX_RETRIES=3
AI_MAX_TOKENS=8000

# ---------- 阿里云 DashScope 虚拟试衣（OutfitAnyone）----------
DASHSCOPE_API_KEY=
DASHSCOPE_TRYON_MODEL=aitryon-plus
DASHSCOPE_REFINE_MODEL=aitryon-refiner
DASHSCOPE_PARSE_MODEL=aitryon-parsing-v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIRTUAL_TRYON_TIMEOUT=120

# ---------- 阿里云视觉智能（衣物分割/人像抠图）----------
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_VISION_ENDPOINT=imageseg.cn-shanghai.aliyuncs.com

# ---------- 阿里云 OSS（图片存储，虚拟试衣要求公网 URL）----------
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_REGION=
ALIYUN_OSS_PUBLIC_URL=

# ---------- 天气：和风天气 v7（国内优先）----------
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 天气：Open-Meteo（海外 fallback）
OPENMETEO_FALLBACK_URL=

# ---------- 淘宝联盟（不配置 APP_KEY 时自动使用 Mock 数据）----------
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
TAOBAO_MATERIAL_ID=17004

# ---------- 通知（ntfy 为默认通道，SMTP/Mattermost 为兼容保留）----------
NTFY_SERVER=
NTFY_TOPIC=
NTFY_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MATTERMOST_WEBHOOK_URL=

# ---------- OIDC 登录（可选，Web 端开发模式用）----------
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_MOBILE_CLIENT_ID=

# ---------- 背景移除（默认 rembg 本地；生产建议走阿里云视觉分割）----------
BG_REMOVAL_PROVIDER=rembg
BG_REMOVAL_MODEL=u2net
BG_REMOVAL_URL=
BG_REMOVAL_API_KEY=

# ---------- 图片处理 ----------
THUMBNAIL_SIZE=400
MEDIUM_SIZE=800
ORIGINAL_MAX_SIZE=2400
IMAGE_QUALITY=90
